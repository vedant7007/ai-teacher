# Gemini AI Studio key. Used only for the one big lesson-plan call and the report.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq free tier. Used for intake parsing, answer grading and re-explanation.
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Local fallback and --offline mode. No key needed.
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_URL=http://localhost:11434

# Route every call to Ollama. Use during development to protect the daily quota.
AI_TEACHER_OFFLINE=0

# Replay the frozen demo lesson instead of generating. Used by the deployed demo.
DEMO_MODE=0
